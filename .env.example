# ============================================================
# AI Data Analyst Agent - 环境变量示例
# 复制为 .env 并填写真实值
# ============================================================

# ---- LLM（OpenAI 兼容接口）----
# 可接入 DeepSeek / Qwen / Kimi / GLM / OpenAI / 本地 vLLM 等
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0
# LLM HTTP 超时（秒）与 429/5xx/网络抖动时的自动重试次数（指数退避）
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ---- Agent 流程控制 ----
MAX_STEPS=15
PYTHON_TIMEOUT_SECONDS=30
# 其他单个工具的执行超时（秒）；超时只影响该次调用，Agent 会拿到超时错误继续
TOOL_TIMEOUT_SECONDS=60
OUTPUT_TRUNCATE_CHARS=4000
# 同一工具连续失败几次后，明确要求模型停止重试该工具（防止把步数耗在同一个错误上）
TOOL_MAX_CONSECUTIVE_FAILURES=3
# 单步（一次 LLM 决策）允许发起的工具调用数量上限
MAX_TOOL_CALLS_PER_STEP=6
# 单次 LLM 调用失败后的额外重试次数（仅针对超时/限流/5xx 等瞬时故障）
AGENT_LLM_RETRIES=2
# 每轮送给 LLM 的历史工具结果保留条数；更早的会被折叠成占位摘要以控制上下文
KEEP_RECENT_TOOL_RESULTS=6
# 数据文件体积上限（字节），超过则直接拒绝读取，避免 pandas 整表读入撑爆内存
MAX_DATASET_BYTES=536870912
# 额外允许读取数据文件的目录（JSON 数组），用于挂载外部数据卷；默认只允许 datasets/
# 注意变量名须与 settings.extra_data_dirs 对应，否则会被静默忽略
# EXTRA_DATA_DIRS=["/data"]

# ---- 连续对话（追问）----
# 注入新一轮分析的历史轮数上限与总字符上限（只取同一数据集的历史）
MEMORY_MAX_TURNS=3
MEMORY_MAX_CHARS=4000

# ---- 基础设施 ----
# PostgreSQL + pgvector 向量库 / Redis（docker compose up -d 启动）
DATABASE_URL=postgresql+psycopg://analyst:analyst@localhost:5432/analyst
REDIS_URL=redis://localhost:6379/0

# ---- 持久化开关 ----
DB_ENABLED=true
REDIS_ENABLED=true
REDIS_CACHE_TTL=3600

# ---- RAG / 向量检索 ----
# Embedding 实现选择（三者接口一致，但检索质量差别很大）：
#   auto   = 有 EMBEDDING_API_KEY 就用真实语义向量，否则回退离线词法向量并告警
#   openai = 强制真实语义向量（缺 Key 直接报错，避免「以为在语义检索其实不是」）
#   hash   = 强制离线词法向量（字符 n-gram 哈希，只做字面匹配、**不是语义模型**），
#            适用于 CI / 完全离线环境；不要在生产检索质量上依赖它
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 离线词法向量的维度（换成真实语义模型后维度由模型决定，无需在此配置）
EMBEDDING_DIM=384
RAG_TOP_K=5

# ---- MCP ----
# 启用后 Agent 会通过 MCP（stdio）发现并调用 MCP 工具（与普通工具共存）
MCP_ENABLED=false
