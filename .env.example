# ============================================================
# AI Data Analyst Agent - 环境变量示例
# 复制为 .env 并填写真实值
# ============================================================

# ---- LLM（OpenAI 兼容接口）----
# 可接入 DeepSeek / Qwen / Kimi / GLM / OpenAI / 本地 vLLM 等
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0
# LLM HTTP 超时（秒）与 429/5xx/网络抖动时的自动重试次数（指数退避）
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ---- Agent ----
MAX_STEPS=15
PYTHON_TIMEOUT_SECONDS=30
OUTPUT_TRUNCATE_CHARS=4000
# 额外允许读取数据文件的目录（JSON 数组），用于挂载外部数据卷；默认只允许 datasets/
# 注意变量名须与 settings.extra_data_dirs 对应，否则会被静默忽略
# EXTRA_DATA_DIRS=["/data"]

# ---- 基础设施 ----
# PostgreSQL + pgvector 向量库 / Redis（docker compose up -d 启动）
DATABASE_URL=postgresql+psycopg://analyst:analyst@localhost:5432/analyst
REDIS_URL=redis://localhost:6379/0

# ---- 持久化开关 ----
DB_ENABLED=true
REDIS_ENABLED=true
REDIS_CACHE_TTL=3600

# ---- RAG / 向量检索 ----
# 填写 EMBEDDING_API_KEY 时使用真实语义向量（OpenAI 兼容接口）；留空则用本地哈希向量（离线可跑）
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=384
RAG_TOP_K=5

# ---- MCP ----
# 启用后 Agent 会通过 MCP（stdio）发现并调用 MCP 工具（与普通工具共存）
MCP_ENABLED=false
